# Generate a random key; do not use this file as a secret store in production.
MVM_MASTER_KEY=
MVM_ORIGIN=https://localhost:8443
MVM_TLS_HOST=localhost
MVM_VERSION=0.2.0-dev
# Explicitly allow only dedicated management hosts or tightly scoped networks.
MVM_ROUTER_CIDRS=
MVM_ALLOW_MUTATIONS=false
MVM_ROUTER_TIMEOUT_SECONDS=20
# Local development only:
# MVM_LISTEN=127.0.0.1:8080
# MVM_ORIGIN=http://localhost:8080
# MVM_DEV_HTTP=true

# Linux edition requires explicit offline bbolt migration before replacing an existing database.
MVM_DATABASE=/data/mvm.db

